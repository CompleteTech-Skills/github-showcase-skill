{
  "worktree": {
    "setup": [
      "node -e \"const cp=require('node:child_process');const py=process.platform==='win32'?'python':'python3';const r=cp.spawnSync(py,['-m','venv','.venv'],{stdio:'inherit'});if(r.error)console.error(r.error.message);process.exit(r.status??1)\"",
      "node -e \"const cp=require('node:child_process');const py=process.platform==='win32'?'.venv/Scripts/python.exe':'.venv/bin/python';const r=cp.spawnSync(py,['-m','pip','install','-r','requirements.txt'],{stdio:'inherit'});if(r.error)console.error(r.error.message);process.exit(r.status??1)\""
    ],
    "teardown": "echo \"Setup starts no persistent services; Paseo handles worktree removal.\""
  },
  "scripts": {
    "diff-check": {
      "command": "git diff --check"
    },
    "validate": {
      "command": "node -e \"const cp=require('node:child_process');const py=process.platform==='win32'?'.venv/Scripts/python.exe':'.venv/bin/python';const r=cp.spawnSync(py,['scripts/validate_package.py'],{stdio:'inherit'});if(r.error)console.error(r.error.message);process.exit(r.status??1)\""
    }
  }
}
