{
  "worktree": {
    "setup": [
      "python -m venv .venv",
      ".venv/Scripts/python.exe -m pip install -r requirements.txt"
    ],
    "teardown": "echo \"Setup starts no persistent services; Paseo handles worktree removal.\""
  },
  "scripts": {
    "diff-check": {
      "command": "git diff --check"
    },
    "validate": {
      "command": ".venv/Scripts/python.exe scripts/validate_package.py"
    }
  }
}
