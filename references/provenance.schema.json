{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/CompleteTech-Skills/github-showcase-skill/references/provenance.schema.json",
 "title": "github-showcase-skill provenance and bounded recorded-output evidence",
 "description": "The `provenance` block of a target's stamp: docs/images/.showcase.json (repository), .github/showcase.json in ORG/.github (organization) or USER/USER (personal profile), <estate root>/registry/enterprise.showcase.json (Enterprise, private). Timestamps and run_count are never part of `fingerprint`. Evidence verifies only recorded output bytes and supplied inputs, never live publication or whole-workflow completion. Legacy stamps without evidence remain detectable but cannot certify freshness.",
 "type": "object",
 "required": [
  "provenance"
 ],
 "properties": {
  "provenance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "skill",
    "skill_url",
    "publisher",
    "skill_version",
    "standard",
    "target",
    "first_run_at",
    "last_run_at",
    "last_changed_at",
    "run_count",
    "fingerprint",
    "surfaces"
   ],
   "properties": {
    "skill": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "skill_url": {
     "type": "string",
     "pattern": "^https://github\\.com/"
    },
    "publisher": {
     "type": "string",
     "minLength": 1
    },
    "skill_version": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.+-][0-9A-Za-z.-]+)?$"
    },
    "standard": {
     "type": "string",
     "pattern": "^ct-std-v[0-9]+(\\.[0-9]+)?$"
    },
    "target": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "id"
     ],
     "properties": {
      "kind": {
       "enum": [
        "repo",
        "org",
        "profile",
        "enterprise"
       ]
      },
      "id": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "first_run_at": {
     "$ref": "#/$defs/utc"
    },
    "last_run_at": {
     "$ref": "#/$defs/utc"
    },
    "last_changed_at": {
     "$ref": "#/$defs/utc"
    },
    "run_count": {
     "type": "integer",
     "minimum": 1
    },
    "fingerprint": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "surfaces": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "evidence": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "scope",
    "inputs",
    "config_sha256",
    "outputs",
    "missing",
    "pending_jobs"
   ],
   "properties": {
    "version": {
     "type": "integer",
     "const": 1
    },
    "scope": {
     "type": "string",
     "const": "recorded-outputs"
    },
    "inputs": {
     "type": "object"
    },
    "config_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "outputs": {
     "type": "object",
     "additionalProperties": false,
     "patternProperties": {
      "^(?!/)(?!.*(?:^|/)(?:\\.\\.?|\\.[gG][iI][tT])(?:/|$))(?!.*[\\\\:?#%\\x00-\\x1f\\x7f])[^/]+(?:/[^/]+)*$": {
       "anyOf": [
        {
         "type": "object",
         "required": [
          "sha256"
         ],
         "additionalProperties": false,
         "properties": {
          "sha256": {
           "type": "string",
           "pattern": "^[0-9a-f]{64}$"
          }
         }
        },
        {
         "type": "object",
         "required": [
          "exempt"
         ],
         "additionalProperties": false,
         "properties": {
          "exempt": {
           "enum": [
            "exempt:no-card",
            "exempt:profile-readme",
            "exempt:placeholder-org"
           ]
          }
         }
        }
       ]
      }
     }
    },
    "missing": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "pending_jobs": {
     "type": "boolean"
    }
   }
  }
 },
 "$defs": {
  "utc": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  }
 }
}
