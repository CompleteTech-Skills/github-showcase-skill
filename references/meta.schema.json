{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CompleteTech-Skills/github-showcase-skill/references/meta.schema.json",
  "title": "Normalized repository metadata (showcase.py meta)",
  "type": "object",
  "required": [
    "owner",
    "repo"
  ],
  "properties": {
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "homepage": {
      "type": [
        "string",
        "null"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fork": {
      "type": "boolean"
    },
    "archived": {
      "type": "boolean"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "internal",
        "unknown"
      ]
    },
    "is_template": {
      "type": "boolean"
    },
    "template_repository": {
      "type": [
        "string",
        "null"
      ],
      "description": "full_name of the template this repository was generated from (GitHub template_repository), or null"
    },
    "template_tagline": {
      "type": [
        "string",
        "null"
      ],
      "description": "the tagline block of that template's README, so header mode empties only an inherited tagline"
    },
    "default_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "stargazers_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "pushed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_substantive_commit": {
      "type": [
        "string",
        "null"
      ],
      "description": "CQ-16: date of the newest default-branch commit whose message does not match ct-std-v1|showcase banner and card|[skip ci] (meta --from-gh)"
    },
    "last_substantive_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "readme_head": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent": {
      "type": [
        "object",
        "null"
      ]
    },
    "id": {
      "type": "integer"
    },
    "node_id": {
      "type": "string"
    },
    "health_percentage": {
      "type": [
        "integer",
        "null"
      ]
    },
    "has_issues": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_wiki": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_projects": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "has_discussions": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "delete_branch_on_merge": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "homepage_status": {
      "type": [
        "integer",
        "null"
      ],
      "description": "HTTP status of the homepage URL (R4); null or absent is unknown"
    },
    "files": {
      "type": [
        "array",
        "object"
      ],
      "description": "Default-branch file tree: the sorted path list meta --from-gh writes, or the fixtures' {path: {bytes, head} | true | null | false} map"
    },
    "files_complete": {
      "type": "boolean",
      "description": "true only when GitHub did not truncate the recursive tree, so an unlisted path is absent"
    },
    "manifests": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "file_sizes": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "has_pages": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "REST has_pages (About sidebar Pages step, deployments fallback)"
    },
    "size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "REST size in KB; 0 marks an empty repository for doctor --estate"
    },
    "releases": {
      "type": [
        "integer",
        "array",
        "object",
        "null"
      ],
      "description": "About sidebar evidence (decision 7): a count, the REST list, or a {totalCount}/{nodes} object; absent means unknown"
    },
    "deployments": {
      "type": [
        "integer",
        "array",
        "object",
        "null"
      ],
      "description": "About sidebar evidence (decision 7): a count, the REST list, or a {totalCount}/{nodes} object; absent means unknown"
    },
    "packages": {
      "type": [
        "integer",
        "array",
        "object",
        "null"
      ],
      "description": "About sidebar evidence (decision 7): a count, the REST list, or a {totalCount}/{nodes} object; absent means unknown"
    },
    "environments": {
      "type": [
        "integer",
        "array",
        "object",
        "null"
      ],
      "description": "About sidebar evidence (decision 7): a count, the REST list, or a {totalCount}/{nodes} object; absent means unknown"
    },
    "uses_custom_og_image": {
      "type": "boolean",
      "description": "R10 evidence: the read-only GraphQL usesCustomOpenGraphImage (that spelling is accepted on input and mapped here); absent when not captured, not a boolean, or the two spellings disagree, so R10 reads unknown"
    },
    "also_in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ahead_by": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "detected": {
      "type": "object"
    }
  }
}
